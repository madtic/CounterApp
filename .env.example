# Copy to .env and adjust if needed. Docker Compose reads this file automatically.

# Which Dockerfile each service builds.
# Try Dockerfile, Dockerfile.alpine or Dockerfile.distroless.
BACKEND_DOCKERFILE=Dockerfile.alpine
FRONTEND_DOCKERFILE=Dockerfile.alpine

# memory or postgres
STORAGE_BACKEND=postgres

# URL the browser uses to reach the backend. Embedded at frontend build time.
VITE_API_BASE_URL=http://localhost:8000

# Comma-separated browser origins allowed by the backend.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Host ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432

# syntax=docker/dockerfile:1

# =============================================================================
# MULTI-STAGE, DISTROLESS
#
# * Node.js only exists in the builder stage
# * runtime is Google's distroless static image (no shell, no package manager)
# * static-web-server is a single, statically linked binary that serves the
#   Vite build
#
# Build:  docker build -f Dockerfile.distroless -t counter-frontend:distroless .
# =============================================================================
FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_API_BASE_URL=http://localhost:8000
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build


FROM ghcr.io/static-web-server/static-web-server:2 AS web-server


FROM gcr.io/distroless/static-debian12:nonroot AS runtime

COPY --from=web-server /static-web-server /usr/local/bin/static-web-server
COPY --from=build /app/dist /public

ENV SERVER_HOST=0.0.0.0 \
    SERVER_PORT=8080 \
    SERVER_ROOT=/public \
    SERVER_FALLBACK_PAGE=/public/index.html \
    SERVER_LOG_LEVEL=info

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/static-web-server"]
